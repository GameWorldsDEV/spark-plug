# Public build-time metadata. Use the exact production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://sparkplug.example.com

# One authority for public behavior: preview, release, or commercial.
# Unknown and missing values fail closed to preview.
NEXT_PUBLIC_SITE_STAGE=preview

# A second, private kill switch for accounts, billing, publishing, and sales.
# Keep false until Google OAuth, Stripe test mode, seller terms, moderation,
# webhooks, rate limits, and adversarial tests all pass.
SPARKPLUG_COMMERCE_READY=false

# Keep previews and unreviewed deployments out of search. Set true only at public launch.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Enable only after the custom domain has valid DNS and HTTPS.
NEXT_PUBLIC_CANONICAL_REDIRECT=false

# Commercial test-mode services. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYMENTS_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
MARKETPLACE_CHECKOUT_READY=false
MARKETPLACE_CONNECT_READY=false
MARKETPLACE_DEFAULT_SELLER_COUNTRY=US
ENTITLEMENT_PRIVATE_KEY_PEM_BASE64=
ENTITLEMENT_PUBLIC_KEY_PEM_BASE64=
ENTITLEMENT_KEY_ID=
ENTITLEMENT_ISSUER=https://sparkplug.gameworlds.ai
