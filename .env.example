# Public build-time metadata. Use the exact production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://sparkplug.example.com

# Keep previews and unreviewed deployments out of search. Set true only at public launch.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Server-only Supabase values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-vercel-environment-settings

# At least 32 random bytes; used only to HMAC request addresses for rate limiting.
WAITLIST_HASH_SECRET=replace-in-vercel-environment-settings

# Reserved for a future verified Stripe webhook implementation.
STRIPE_SECRET_KEY=replace-in-vercel-environment-settings
STRIPE_WEBHOOK_SECRET=replace-in-vercel-environment-settings
