{
  "openapi": "3.1.0",
  "info": {
    "title": "Spark Plug Public Service API",
    "version": "1.0.0",
    "description": "Clean-room public catalog, locally verifiable entitlements, and payment webhook boundary. Local agents, routes, prompts, outputs, and host paths are out of scope."
  },
  "servers": [{ "url": "https://sparkplug.gameworlds.ai" }],
  "paths": {
    "/api/v1/catalog/profiles": {
      "get": {
        "summary": "List approved public profile metadata",
        "security": [],
        "parameters": [
          { "in": "query", "name": "limit", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 24 } },
          { "in": "query", "name": "before", "description": "Opaque cursor containing both stable sort keys", "schema": { "type": "string", "maxLength": 512 } }
        ],
        "responses": {
          "200": {
            "description": "Cacheable metadata. Manifest bodies are deliberately absent.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogPage" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/v1/catalog/profiles/{slug}/manifest": {
      "get": {
        "summary": "Fetch one immutable manifest",
        "description": "Approved profiles in the first marketplace are free and require no account lookup. Paid marketplace delivery is not implemented.",
        "security": [],
        "parameters": [{ "in": "path", "name": "slug", "required": true, "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" } }],
        "responses": {
          "200": {
            "description": "Authorized immutable manifest envelope",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManifestEnvelope" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/entitlements/refresh": {
      "post": {
        "summary": "Refresh a stale Pro entitlement snapshot",
        "description": "The local Community tier never calls this route. Pro calls it only on explicit refresh or when the locally verified snapshot is near expiry.",
        "security": [{ "supabaseAccessToken": [] }],
        "responses": {
          "200": {
            "description": "A seven-day Ed25519-signed Pro snapshot, or a null Community result",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EntitlementRefresh" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/.well-known/sparkplug-entitlement-keys": {
      "get": {
        "summary": "Get public entitlement verification keys",
        "security": [],
        "responses": {
          "200": {
            "description": "Long-cacheable Ed25519 JWK set",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JwkSet" } } }
          }
        }
      }
    },
    "/api/v1/forum/posts": {
      "get": {
        "summary": "List approved forum posts",
        "x-sparkplug-status": "database-ready-route-gated",
        "security": [],
        "responses": { "200": { "description": "Bounded, cursor-paginated approved posts" } }
      },
      "post": {
        "summary": "Submit a forum post for moderation",
        "x-sparkplug-status": "database-ready-route-gated",
        "security": [{ "supabaseAccessToken": [] }],
        "responses": { "202": { "description": "Accepted into pending moderation" }, "429": { "description": "Write budget exceeded" } }
      }
    },
    "/api/v1/forum/posts/{postId}/comments": {
      "get": {
        "summary": "List approved comments",
        "x-sparkplug-status": "database-ready-route-gated",
        "security": [],
        "responses": { "200": { "description": "Approved comments without voter identities" } }
      },
      "post": {
        "summary": "Submit a comment for moderation",
        "x-sparkplug-status": "database-ready-route-gated",
        "security": [{ "supabaseAccessToken": [] }],
        "responses": { "202": { "description": "Accepted into pending moderation" }, "429": { "description": "Write budget exceeded" } }
      }
    },
    "/api/v1/forum/votes": {
      "put": {
        "summary": "Create, change, or remove the caller's vote",
        "x-sparkplug-status": "database-ready-route-gated",
        "security": [{ "supabaseAccessToken": [] }],
        "responses": { "204": { "description": "Vote state applied idempotently" }, "429": { "description": "Write budget exceeded" } }
      }
    },
    "/api/v1/profiles": {
      "post": {
        "summary": "Validate and submit a declarative profile draft",
        "description": "The server revalidates the strict schema, canonicalizes the profile, attaches audit/risk labels, and stores an immutable version only through a service-owned path.",
        "x-sparkplug-status": "implemented-ui-and-moderation-activation-gated",
        "security": [{ "supabaseAccessToken": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileSubmission" } } }
        },
        "responses": { "202": { "description": "Pending moderation" }, "422": { "description": "Schema, HF pin, checksum, or risk validation failed" }, "429": { "description": "Validation budget exceeded" } }
      }
    },
    "/api/v1/billing/checkout": {
      "post": {
        "summary": "Create an allowlisted Pro subscription checkout",
        "description": "Commercial-stage only. The authenticated browser selects monthly or annual cadence; the server supplies the approved Stripe price ID.",
        "security": [{ "supabaseAccessToken": [] }],
        "responses": { "200": { "description": "Stripe-hosted checkout URL" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "503": { "$ref": "#/components/responses/Unavailable" } }
      }
    },
    "/api/v1/billing/portal": {
      "post": {
        "summary": "Create an authenticated Stripe billing portal session",
        "security": [{ "supabaseAccessToken": [] }],
        "responses": { "200": { "description": "Stripe-hosted billing portal URL" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "503": { "$ref": "#/components/responses/Unavailable" } }
      }
    },
    "/api/stripe/webhook": {
      "post": {
        "summary": "Receive a signed Stripe event",
        "description": "Provider-only route. Disabled unless PAYMENTS_MODE is explicitly test or live. Raw payloads are verified, reduced to a safe projection, and never persisted.",
        "security": [{ "stripeSignature": [] }],
        "responses": {
          "200": { "description": "Processed, ignored, or duplicate event" },
          "400": { "description": "Invalid signature or stale timestamp" },
          "409": { "description": "A fresh idempotency lease is still processing; provider should retry" },
          "503": { "description": "Payments intentionally disabled or not configured" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "supabaseAccessToken": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "stripeSignature": { "type": "apiKey", "in": "header", "name": "Stripe-Signature" }
    },
    "responses": {
      "BadRequest": { "description": "Invalid request" },
      "Unauthorized": { "description": "Authentication or purchase required" },
      "NotFound": { "description": "Not found or not authorized" },
      "Unavailable": { "description": "Temporarily unavailable or intentionally not configured" }
    },
    "schemas": {
      "CatalogProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "title", "summary", "access", "price_cents", "currency", "published_at", "creator_handle", "creator_display_name", "creator_class", "risk_level", "risk_labels", "current_manifest_sha256"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "access": { "const": "free" },
          "price_cents": { "const": 0 },
          "currency": { "type": "string", "pattern": "^[a-z]{3}$" },
          "published_at": { "type": "string", "format": "date-time" },
          "creator_handle": { "type": "string" },
          "creator_display_name": { "type": "string" },
          "creator_class": { "enum": ["community", "verified_creator", "verified_business", "gameworlds_official"] },
          "risk_level": { "enum": ["low", "review", "high"] },
          "risk_labels": { "type": "array", "items": { "type": "string" } },
          "current_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "CatalogPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profiles", "next", "manifestDelivery"],
        "properties": {
          "profiles": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogProfile" } },
          "next": { "type": ["string", "null"], "maxLength": 512 },
          "manifestDelivery": { "const": "separate-authorized-route" }
        }
      },
      "ManifestEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "manifest", "manifestSha256", "riskLevel", "riskLabels"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "manifest": { "$ref": "../schemas/setup-profile.v1.schema.json" },
          "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "riskLevel": { "enum": ["low", "review", "high"] },
          "riskLabels": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ProfileSubmission": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "summary", "access", "priceCents", "currency", "manifest"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "access": { "const": "free" },
          "priceCents": { "const": 0 },
          "currency": { "const": "usd" },
          "manifest": { "$ref": "../schemas/setup-profile.v1.schema.json" }
        }
      },
      "EntitlementRefresh": {
        "oneOf": [
          {
            "type": "object",
            "required": ["plan", "entitlement", "expiresAt", "refreshAfter", "keySetUrl"],
            "properties": {
              "plan": { "const": "pro" },
              "entitlement": { "type": "string", "maxLength": 8192 },
              "expiresAt": { "type": "integer" },
              "refreshAfter": { "type": "integer" },
              "keySetUrl": { "const": "/.well-known/sparkplug-entitlement-keys" }
            }
          },
          {
            "type": "object",
            "required": ["plan", "entitlement", "refreshAfter"],
            "properties": {
              "plan": { "const": "community" },
              "entitlement": { "type": "null" },
              "refreshAfter": { "type": "null" }
            }
          }
        ]
      },
      "JwkSet": {
        "type": "object",
        "required": ["keys"],
        "properties": { "keys": { "type": "array", "items": { "type": "object" } } }
      }
    }
  }
}
