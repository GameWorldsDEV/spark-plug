{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkplug.gameworlds.ai/schemas/profile-package.v1.schema.json",
  "title": "Spark Plug signed profile package v1",
  "description": "A signed, declarative marketplace envelope around a Spark Plug setup profile. It cannot carry executable code, credentials, model weights, private paths, prompts, or runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "packageId", "version", "createdAt", "creator", "origin", "profile", "licenseEvidence", "integrity", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "sparkplug.profile-package" },
    "packageId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+){1,9}$", "maxLength": 160 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$", "maxLength": 64 },
    "createdAt": { "type": "string", "format": "date-time" },
    "creator": { "$ref": "#/$defs/creator" },
    "origin": { "$ref": "#/$defs/origin" },
    "profile": { "$ref": "https://sparkplug.gameworlds.ai/schemas/setup-profile.v1.schema.json" },
    "licenseEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/licenseEvidence" }
    },
    "integrity": { "$ref": "#/$defs/integrity" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "profileUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "marketplaceOrigin", "listingSlug", "listingVersionId"],
      "properties": {
        "source": { "const": "sparkplug-marketplace" },
        "marketplaceOrigin": { "type": "string", "format": "uri", "pattern": "^https://[^/?#]+$" },
        "listingSlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
        "listingVersionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 }
      }
    },
    "licenseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelAlias", "engine", "repoId", "revision", "licenseId", "licenseUrl", "gated", "requiresAcceptance", "commercialUse", "reviewedAt", "decisionId"],
      "properties": {
        "modelAlias": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
        "engine": { "enum": ["vllm", "colibri", "mlx", "ollama", "llama.cpp", "transformers", "comfyui"] },
        "repoId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "licenseId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$" },
        "licenseUrl": { "type": "string", "format": "uri", "pattern": "^https://huggingface\\.co/" },
        "gated": { "type": "boolean" },
        "requiresAcceptance": { "type": "boolean" },
        "commercialUse": { "enum": ["allowed", "noncommercial", "review-required", "blocked"] },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "decisionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "hashAlgorithm", "profileSha256"],
      "properties": {
        "canonicalization": { "const": "sparkplug-json-v1" },
        "hashAlgorithm": { "const": "sha256" },
        "profileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value", "signedAt"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 120 },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" },
        "signedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
