{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkplug.gameworlds.ai/schemas/setup-profile.v1.schema.json",
  "title": "Spark Plug declarative setup profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "name", "summary", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "sparkplug.setup-profile" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/model" }
    },
    "routing": { "$ref": "#/$defs/routing" }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoId", "revision", "licenseId", "gated", "files", "runtime"],
      "properties": {
        "repoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "licenseId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$" },
        "gated": { "type": "boolean" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/file" }
        },
        "runtime": { "$ref": "#/$defs/runtime" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 2199023255552 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "engine"],
      "properties": {
        "alias": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
        "engine": { "enum": ["vllm", "colibri", "mlx", "ollama", "llama.cpp", "transformers", "comfyui"] },
        "quantization": { "enum": ["none", "awq", "gptq", "gguf", "bitsandbytes"] },
        "maxContextTokens": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "settings": { "oneOf": [{ "$ref": "#/$defs/vllmSettings" }, { "$ref": "#/$defs/colibriSettings" }, { "$ref": "#/$defs/mlxSettings" }, { "$ref": "#/$defs/ollamaSettings" }, { "$ref": "#/$defs/llamaCppSettings" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "engine": { "const": "vllm" } }, "required": ["engine"] },
          "then": { "properties": { "settings": { "$ref": "#/$defs/vllmSettings" } } }
        },
        {
          "if": { "properties": { "engine": { "const": "colibri" } }, "required": ["engine"] },
          "then": { "properties": { "settings": { "$ref": "#/$defs/colibriSettings" } } }
        },
        {
          "if": { "properties": { "engine": { "const": "mlx" } }, "required": ["engine"] },
          "then": { "properties": { "settings": { "$ref": "#/$defs/mlxSettings" } }, "required": ["settings"] }
        },
        {
          "if": { "properties": { "engine": { "const": "ollama" } }, "required": ["engine"] },
          "then": { "properties": { "settings": { "$ref": "#/$defs/ollamaSettings" } }, "required": ["settings"] }
        },
        {
          "if": { "properties": { "engine": { "const": "llama.cpp" } }, "required": ["engine"] },
          "then": { "properties": { "settings": { "$ref": "#/$defs/llamaCppSettings" } }, "required": ["settings"] }
        },
        {
          "if": { "properties": { "engine": { "not": { "enum": ["vllm", "colibri", "mlx", "ollama", "llama.cpp"] } } }, "required": ["engine"] },
          "then": { "properties": { "settings": false } }
        }
      ]
    },
    "vllmSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kvCacheDtype", "streamingEnabled", "gpuMemoryUtilization", "toolCallParser", "reasoningParser"],
      "properties": {
        "kvCacheDtype": { "enum": ["auto", "fp8", "fp16"] },
        "streamingEnabled": { "type": "boolean" },
        "gpuMemoryUtilization": { "type": "number", "minimum": 0.05, "maximum": 0.99 },
        "toolCallParser": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "reasoningParser": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
      }
    },
    "colibriSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presetId", "computeBackend", "gpuMemoryBudgetGiB", "resourcePolicy", "automaticTier", "useTuneProfile", "repinTokens", "expertCacheSlots", "memoryLimitMode", "memoryLimitGiB", "streamingEnabled", "maxOutputTokens", "reasoningEffort", "temperature", "topP"],
      "properties": {
        "presetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "computeBackend": { "enum": ["cpu", "cuda", "vulkan", "auto"] },
        "gpuMemoryBudgetGiB": { "enum": [0, 4, 8, 12, 16, 20, 24] },
        "resourcePolicy": { "enum": ["quality", "balanced", "experimental-fast"] },
        "automaticTier": { "type": "boolean" },
        "useTuneProfile": { "type": "boolean" },
        "repinTokens": { "enum": [0, 16, 32, 64, 128] },
        "expertCacheSlots": { "enum": [8, 16, 32, 64, 128, 256] },
        "memoryLimitMode": { "enum": ["automatic", "manual"] },
        "memoryLimitGiB": { "type": "number", "minimum": 0, "maximum": 120, "multipleOf": 0.5 },
        "streamingEnabled": { "type": "boolean" },
        "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "reasoningEffort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh"] },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "topP": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "mlxSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefillStepTokens"],
      "properties": {
        "prefillStepTokens": { "type": "integer", "minimum": 128, "maximum": 8192, "multipleOf": 128 }
      }
    },
    "ollamaSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchTokens", "gpuLayers", "threadCount", "keepAliveSeconds", "flashAttention", "streamingEnabled", "thinkingMode"],
      "properties": {
        "batchTokens": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "gpuLayers": { "type": "integer", "minimum": 0, "maximum": 999 },
        "threadCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "keepAliveSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "flashAttention": { "type": "boolean" },
        "streamingEnabled": { "type": "boolean" },
        "thinkingMode": { "enum": ["auto", "off", "on", "low", "medium", "high", "max"] }
      }
    },
    "llamaCppSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchTokens", "microBatchTokens", "gpuLayers", "threadCount", "flashAttention", "streamingEnabled", "jinja", "reasoningFormat", "reasoningMode", "reasoningBudgetTokens"],
      "properties": {
        "batchTokens": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "microBatchTokens": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "gpuLayers": { "type": "integer", "minimum": 0, "maximum": 999 },
        "threadCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "flashAttention": { "type": "boolean" },
        "streamingEnabled": { "type": "boolean" },
        "jinja": { "type": "boolean" },
        "reasoningFormat": { "enum": ["auto", "none", "deepseek", "deepseek-legacy"] },
        "reasoningMode": { "enum": ["auto", "on", "off"] },
        "reasoningBudgetTokens": { "type": "integer", "minimum": -1, "maximum": 1048576 }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultModelAlias", "capabilities"],
      "properties": {
        "defaultModelAlias": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "enum": ["chat", "code", "tools", "thinking", "vision", "streaming", "embeddings", "image", "video", "3d"] }
        }
      }
    }
  }
}
