{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkplug.gameworlds.ai/schemas/marketplace-listing.v1.schema.json",
  "title": "Spark Plug Marketplace Listing",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "title", "assetType", "license", "priceCents", "compatibility", "support"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "assetType": { "enum": ["profile", "theme", "motion-pack", "lora-adapter"] },
    "license": { "type": "string", "minLength": 1, "maxLength": 120 },
    "priceCents": { "type": "integer", "minimum": 0 },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deviceMaker", "deviceModel", "operatingSystem", "architecture", "memoryGb", "engine", "engineVersion", "modelRevision", "testedAt"],
        "properties": {
          "deviceMaker": { "type": "string", "minLength": 1 },
          "deviceModel": { "type": "string", "minLength": 1 },
          "operatingSystem": { "type": "string", "minLength": 1 },
          "architecture": { "enum": ["arm64", "x86_64"] },
          "memoryGb": { "type": "number", "exclusiveMinimum": 0 },
          "gpu": { "type": "string" },
          "vramGb": { "type": "number", "minimum": 0 },
          "engine": { "type": "string", "minLength": 1 },
          "engineVersion": { "type": "string", "minLength": 1 },
          "modelRevision": { "type": "string", "minLength": 1 },
          "testedAt": { "type": "string", "format": "date-time" },
          "notes": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creatorSupportUrl", "status"],
      "properties": {
        "creatorSupportUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "status": { "enum": ["active", "maintenance", "abandoned"] }
      }
    }
  }
}
