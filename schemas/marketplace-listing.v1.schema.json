{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkplug.gameworlds.ai/schemas/marketplace-listing.v1.schema.json",
  "title": "Spark Plug Marketplace Listing v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "title", "summary", "assetType", "license", "priceCents", "engineTargets", "package", "compatibility", "support"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "assetType": { "enum": ["profile", "theme", "motion-pack", "lora-adapter"] },
    "license": { "type": "string", "minLength": 1, "maxLength": 120 },
    "priceCents": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "engineTargets": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "enum": ["vllm", "colibri", "mlx", "ollama", "llama.cpp", "transformers", "comfyui"] }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "mediaType", "sha256", "sizeBytes"],
      "properties": {
        "filename": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$", "maxLength": 240 },
        "mediaType": { "enum": ["application/vnd.gameworlds.sparkplug-profile+json", "application/vnd.gameworlds.sparkplug-theme+json", "application/vnd.gameworlds.sparkplug-motion+json", "application/octet-stream"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 10737418240 }
      }
    },
    "compatibility": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/compatibility" }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creatorSupportUrl", "status"],
      "properties": {
        "creatorSupportUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "status": { "enum": ["active", "maintenance", "abandoned"] }
      }
    }
  },
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appVersion", "operatingSystem", "architecture", "testedAt"],
      "properties": {
        "appVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "deviceMaker": { "type": "string", "minLength": 1, "maxLength": 120 },
        "deviceModel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "operatingSystem": { "type": "string", "minLength": 1, "maxLength": 120 },
        "architecture": { "enum": ["arm64", "x86_64"] },
        "memoryGb": { "type": "number", "exclusiveMinimum": 0, "maximum": 4096 },
        "gpu": { "type": "string", "maxLength": 120 },
        "vramGb": { "type": "number", "minimum": 0, "maximum": 4096 },
        "engine": { "enum": ["vllm", "colibri", "mlx", "ollama", "llama.cpp", "transformers", "comfyui"] },
        "engineVersion": { "type": "string", "maxLength": 100 },
        "modelRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "reducedMotionTested": { "type": "boolean" },
        "contrastTested": { "type": "boolean" },
        "testedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "assetType": { "enum": ["profile", "lora-adapter"] } }, "required": ["assetType"] },
      "then": {
        "properties": {
          "compatibility": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/compatibility" },
                { "required": ["deviceMaker", "deviceModel", "memoryGb", "engine", "engineVersion", "modelRevision"] }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "assetType": { "enum": ["theme", "motion-pack"] } }, "required": ["assetType"] },
      "then": {
        "properties": {
          "compatibility": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/compatibility" },
                { "required": ["reducedMotionTested", "contrastTested"] }
              ]
            }
          }
        }
      }
    }
  ]
}
