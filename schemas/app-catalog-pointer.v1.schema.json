{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkplug.gameworlds.ai/schemas/app-catalog-pointer.v1.schema.json",
  "title": "Spark Plug monthly app catalog pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "currentVersion",
    "publishedAt",
    "validUntil",
    "snapshotUrl",
    "sha256",
    "itemCount",
    "refreshPolicy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "currentVersion": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}\\.[1-9][0-9]*$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "snapshotUrl": { "type": "string", "format": "uri-reference", "pattern": "^/catalog/app/" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "itemCount": { "type": "integer", "minimum": 0 },
    "refreshPolicy": { "const": "not-before-valid-until" }
  }
}
