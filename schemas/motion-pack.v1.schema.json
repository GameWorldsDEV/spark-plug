{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkplug.gameworlds.ai/schemas/motion-pack.v1.schema.json",
  "title": "Spark Plug declarative motion pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "name", "summary", "license", "reducedMotion", "motions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "sparkplug.motion-pack" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "license": { "type": "string", "minLength": 1, "maxLength": 120 },
    "reducedMotion": { "enum": ["disabled", "fade-only", "static"] },
    "motions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "durationMs", "easing", "iterations", "keyframes"],
        "properties": {
          "slot": { "enum": ["app-enter", "panel-enter", "profile-switch", "model-load", "queue-pulse", "success", "warning"] },
          "durationMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
          "easing": { "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out"] },
          "iterations": { "type": "integer", "minimum": 1, "maximum": 20 },
          "keyframes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": { "$ref": "#/$defs/keyframe" }
          }
        }
      }
    }
  },
  "$defs": {
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset"],
      "properties": {
        "offset": { "type": "number", "minimum": 0, "maximum": 1 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "translateX": { "type": "number", "minimum": -2000, "maximum": 2000 },
        "translateY": { "type": "number", "minimum": -2000, "maximum": 2000 },
        "scale": { "type": "number", "minimum": 0, "maximum": 10 },
        "rotateDeg": { "type": "number", "minimum": -1080, "maximum": 1080 }
      }
    }
  }
}
